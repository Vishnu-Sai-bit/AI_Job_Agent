# ==========================================================
# AI Job Copilot - Environment Configuration
# ==========================================================

# Flask App Secret
SECRET_KEY=ai-job-copilot-production-key-change-me

# JWT Authentication Secret
JWT_SECRET=ai_job_agent_jwt_secret_key_2026_super_secure_vault

# Google OAuth 2.0 Credentials (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Google SMTP (Gmail) Configuration for OTP & Emails
# Generate App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_SENDER_NAME=AI JobAgent

# Database Connection (Leave empty to use local SQLite)
DATABASE_URL=sqlite:///data/job_copilot.db
# DATABASE_URL=postgresql://postgres:password@localhost:5432/jobagent

# AI Engine / LLM
GEMINI_API_KEY=your_gemini_api_key_here
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=llama3.2:latest

# Job Board APIs
RAPIDAPI_KEY=your_rapidapi_key
RAPIDAPI_HOST=jsearch.p.rapidapi.com
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
JOOBLE_API_KEY=your_jooble_api_key
SERPAPI_API_KEY=your_serpapi_api_key
